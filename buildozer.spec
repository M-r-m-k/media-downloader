[app]
title = Media Downloader
package.name = mediadownloader
package.domain = org.ammar
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,yt-dlp,gallery-dl,click,python-dotenv
android.api = 33
android.ndk = 25b
android.sdk = 24
android.buildtools = 30.0.3
android.use_aapt2 = True
android.permissions = INTERNET,WRITE_EXTERNAL_STORAGE
